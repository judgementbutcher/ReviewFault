<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ReviewFault</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.2</Version>
    <ReviewFaultRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</ReviewFaultRoot>
    <NativeBuildDir>$(BaseIntermediateOutputPath)native</NativeBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <Content Include="$(ReviewFaultRoot)\schema\migrations\001_initial.sql"
             Link="schema\001_initial.sql"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ReviewFaultRoot)\schema\migrations\002_v0_2.sql"
             Link="schema\002_v0_2.sql"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildReviewFaultNative" BeforeTargets="Build" Condition="'$(SkipNativeBuild)' != 'true'">
    <Exec Command="cmake -S &quot;$(ReviewFaultRoot)&quot; -B &quot;$(NativeBuildDir)&quot; -DBUILD_SHARED_LIBS=ON -DREVIEWFAULT_BUILD_TESTS=OFF -A $(Platform)" />
    <Exec Command="cmake --build &quot;$(NativeBuildDir)&quot; --config $(Configuration)" />
    <Copy SourceFiles="$(NativeBuildDir)\$(Configuration)\reviewfault_core.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>

SYNC_DOMAIN=sync.example.com
SYNC_IMAGE=reviewfault-sync:0.4.0
POSTGRES_PASSWORD=generate-a-long-random-secret
JWT_KEY=generate-at-least-32-random-bytes
MASTER_KEY_BASE64=base64-of-exactly-32-random-bytes
S3_ACCESS_KEY=generate-a-random-access-key
S3_SECRET_KEY=generate-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reviewfault
SMTP_PASSWORD=generate-a-long-random-secret
SMTP_FROM=ReviewFault <no-reply@example.com>
METRICS_TOKEN=generate-at-least-32-random-bytes

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewfault.app/schema/backup-v4.schema.json",
  "title": "ReviewFault backup manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "appVersion", "schemaVersion", "schedulerAbiVersion", "exportedAt", "files", "excludedTables"],
  "properties": {
    "format": { "const": "reviewfault-backup" },
    "version": { "const": 4 },
    "appVersion": { "type": "string", "pattern": "^0\\.4\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "schemaVersion": { "const": 4 },
    "schedulerAbiVersion": { "const": 4 },
    "exportedAt": { "type": "integer", "minimum": 1 },
    "excludedTables": {
      "const": ["local_device", "sync_cursor", "sync_revision", "sync_outbox", "sync_conflict", "local_ink_draft"]
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:database\\.sqlite|media/(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))[A-Za-z0-9._/-]+)$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewfault.app/schema/reviewfault-ink-v1.schema.json",
  "title": "reviewfault-ink v1 (JSON before gzip)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "pages"],
  "properties": {
    "format": { "const": "reviewfault-ink" },
    "version": { "const": 1 },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "strokes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "backgroundMediaSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "strokes": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["tool", "color", "width", "points"],
              "properties": {
                "tool": { "enum": ["pen", "highlighter", "eraser"] },
                "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{8}$" },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "points": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["x", "y", "pressure", "time"],
                    "properties": {
                      "x": { "type": "number", "minimum": 0, "maximum": 1 },
                      "y": { "type": "number", "minimum": 0, "maximum": 1 },
                      "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
                      "tiltX": { "type": "number", "minimum": -90, "maximum": 90 },
                      "tiltY": { "type": "number", "minimum": -90, "maximum": 90 },
                      "time": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
